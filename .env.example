# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"
SANITY_API_TOKEN=""

# Stripe
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# bKash Tokenized Checkout (sandbox or production)
# Sandbox: get keys from https://merchantdemo.sandbox.bka.sh/ → API Key tab
# Set BKASH_MODE=live (and BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta) for production.
BKASH_MODE="sandbox"
BKASH_BASE_URL=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# Protects /api/cron/expire-orders (Vercel Cron sends it as a Bearer token).
CRON_SECRET=""

# Optional: force the database driver (auto-detects Neon from the URL).
# DATABASE_DRIVER="pg"

# Optional seed credentials (defaults are for local development only).
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""

# Public site address used for canonical URLs, sitemap and share links.
# On Vercel the production domain is detected automatically; set this once you
# connect a custom domain, e.g. https://eidbazar.com
NEXT_PUBLIC_SITE_URL=""

# Optional: e-mail for password reset links and staff invites (https://resend.com).
# Without it, reset links go by SMS (when SMS is set up) and the owner copies invite links.
RESEND_API_KEY=""
MAIL_FROM=""

# Optional: "Continue with Google" on sign-in (Google Cloud → OAuth client, redirect
# URI https://<your-domain>/api/auth/callback/google). Without them the button is hidden.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
