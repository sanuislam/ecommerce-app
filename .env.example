# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ecommerce?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"
SANITY_API_TOKEN=""

# Stripe
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# bKash Tokenized Checkout (sandbox or production)
# Sandbox: get keys from https://merchantdemo.sandbox.bka.sh/ → API Key tab
# Set BKASH_MODE=live (and BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta) for production.
BKASH_MODE="sandbox"
BKASH_BASE_URL=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_APP_KEY=""
BKASH_APP_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
