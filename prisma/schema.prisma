// Prisma schema for the e-commerce app.
// Models cover authentication, catalog, cart, orders, and reviews.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  /// Shop staff: what they can do comes from `User.staffRole`.
  STAFF
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  STRIPE
  BKASH
  NAGAD
  ROCKET
  UPAY
  COD
}

model User {
  id            String    @id @default(cuid())
  name          String?
  firstName     String?
  lastName      String?
  phone         String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  /// For STAFF: manager | orders | inventory | content.
  staffRole     String?
  /// Two-factor sign-in (TOTP). The secret is encrypted; recovery codes are hashed.
  twoFactorSecret    String?
  twoFactorEnabledAt DateTime?
  twoFactorRecovery  String[]  @default([])
  /// Sessions issued before this are signed out.
  passwordChangedAt  DateTime?
  /// The customer asked not to get promotional SMS (order messages still go).
  smsOptOut          Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  orders    Order[]
  reviews   Review[]
  addresses Address[]
  cart      Cart?
  wishlist  WishlistItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  price       Decimal  @db.Decimal(10, 2)
  compareAt   Decimal? @db.Decimal(10, 2)
  stock       Int      @default(0)
  images      String[] @default([])
  featured          Boolean @default(false)
  flashDeal         Boolean @default(false)
  flashDealDiscount Int?
  published         Boolean @default(true)
  /// What one unit costs the shop (for profit). Options may override it.
  costPrice         Decimal? @db.Decimal(10, 2)
  /// Warn when stock is at or below this (null = the shop default).
  lowStockAt        Int?
  /// Free labels for collections / filters ("eid-2026", "new").
  tags              String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]
  cartItems  CartItem[]
  reviews    Review[]
  variants   ProductVariant[]
  stockMoves StockMovement[]
  wishlistedBy WishlistItem[]

  @@index([slug])
  @@index([featured])
  @@index([flashDeal])
}

/// A purchasable option of a product (e.g. size M / colour Red).
/// When a product has variants, stock and (optionally) price live here and
/// Product.stock is kept as the sum of variant stock.
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  size      String   @default("")
  color     String   @default("")
  sku       String?
  price     Decimal? @db.Decimal(10, 2)
  costPrice Decimal? @db.Decimal(10, 2)
  stock     Int      @default(0)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique
  description  String     @default("")
  type         CouponType @default(PERCENT)
  value        Decimal    @db.Decimal(10, 2)
  minSubtotal  Decimal    @default(0) @db.Decimal(10, 2)
  maxDiscount  Decimal?   @db.Decimal(10, 2)
  usageLimit   Int?
  perUserLimit Int?
  usedCount    Int        @default(0)
  startsAt     DateTime?
  endsAt       DateTime?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  orders Order[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  fullName   String
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String  @default("BD")
  isDefault  Boolean @default(false)
  /// Hidden from the address book but kept for past orders.
  archived   Boolean @default(false)
  createdAt  DateTime @default(now())
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
}

model Order {
  id           String      @id @default(cuid())
  /// Order number customers see (shown as EB-10001). Never reused.
  number       Int         @unique @default(autoincrement())
  userId       String
  status       OrderStatus @default(PENDING)
  subtotal     Decimal     @db.Decimal(10, 2)
  discount     Decimal     @default(0) @db.Decimal(10, 2)
  tax          Decimal     @default(0) @db.Decimal(10, 2)
  shipping     Decimal     @default(0) @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  currency     String      @default("BDT")
  couponId     String?
  couponCode   String?
  shippingZone String?
  courier        String?
  trackingNumber String?
  stripeId     String?     @unique
  bkashPaymentId String?   @unique
  upayTxnId      String?   @unique
  /// Where the order came from: web (checkout) or a channel an admin typed it in from.
  source         String    @default("web")
  /// Admin who created / last edited the order by hand.
  createdById    String?
  courierConsignmentId String?
  courierStatus        String?
  courierUpdatedAt     DateTime?
  courierCharge        Decimal?  @db.Decimal(10, 2)
  /// The Purchase event went to the Facebook Conversions API (sent once).
  trackedAt            DateTime?
  /// Cash on delivery: confirmed by a call to the customer (or OTP at checkout).
  codConfirmedAt       DateTime?
  codCallAttempts      Int       @default(0)
  codConfirmNote       String?
  /// Sum of refunds paid back on this order (returns, partial refunds).
  refundedAmount       Decimal   @default(0) @db.Decimal(10, 2)
  addressId    String?
  paymentEmail String?
  paymentMethod        PaymentMethod @default(STRIPE)
  paymentSenderNumber  String?
  paymentTransactionId String?
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address?    @relation(fields: [addressId], references: [id])
  coupon  Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  events  OrderEvent[]
  returns ReturnRequest[]

  @@index([paymentTransactionId])
  @@index([courier, courierConsignmentId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Timeline entry shown to the customer on the order tracking page.
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  variantName String?
  name        String
  price       Decimal @db.Decimal(10, 2)
  quantity    Int
  image       String?
  /// Unit cost when sold (copied from the product / option).
  costPrice   Decimal? @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  returnItems ReturnItem[]
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  title     String?
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
}

model SiteSettings {
  id            String   @id @default("default")
  facebookUrl   String   @default("")
  whatsappUrl   String   @default("")
  instagramUrl  String   @default("")
  supportEmail  String   @default("")
  supportPhone  String   @default("")
  address       String   @default("")
  shippingInsideDhaka   Int @default(80)
  shippingOutsideDhaka  Int @default(120)
  freeShippingThreshold Int @default(1000)
  /// "Every day 10 am – 10 pm"; empty hides the support-hours line.
  supportHours  String   @default("")
  /// Tawk.to "propertyId/widgetId"; empty turns the chat off.
  tawkId        String   @default("")
  /// Coupon given to new newsletter subscribers (empty = no offer).
  newsletterCoupon String @default("")
  /// End of the current flash sale (countdown); null = no countdown.
  flashSaleEndsAt  DateTime?
  updatedAt     DateTime @updatedAt
}

/// Fixed-window counters used to rate-limit sign-in, sign-up and other
/// abuse-prone endpoints. Works across serverless instances.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model PaymentSettings {
  id              String   @id @default("default")
  bkashEnabled    Boolean  @default(false)
  bkashMode       String   @default("sandbox")
  bkashUsername   String   @default("")
  bkashPassword   String   @default("")
  bkashAppKey     String   @default("")
  bkashAppSecret  String   @default("")
  // Upay merchant payment gateway (API v4.1.0)
  upayEnabled        Boolean @default(false)
  upayBaseUrl        String  @default("https://uat-pg.upay.systems")
  upayMerchantId     String  @default("")
  upayMerchantKey    String  @default("")
  upayMerchantName   String  @default("")
  upayMerchantCode   String  @default("")
  upayMerchantCity   String  @default("Dhaka")
  upayMerchantMobile String  @default("")
  updatedAt       DateTime @updatedAt
}

model SeoSettings {
  id                      String   @id @default("default")
  siteName                String   @default("Eid Bazar")
  titleTemplate           String   @default("%s | Eid Bazar")
  defaultTitle            String   @default("Eid Bazar — Modern e-commerce")
  defaultDescription      String   @default("Your trusted Eid shopping destination — curated finds, fair prices, and fast delivery across Bangladesh.")
  defaultKeywords         String   @default("")
  defaultOgImage          String   @default("")
  twitterHandle           String   @default("")
  googleSiteVerification  String   @default("")
  bingSiteVerification    String   @default("")
  facebookAppId           String   @default("")
  ga4MeasurementId        String   @default("")
  gtmContainerId          String   @default("")
  metaPixelId             String   @default("")
  jsonLdEnabled           Boolean  @default(true)
  organizationLogoUrl     String   @default("")
  updatedAt               DateTime @updatedAt
}

model PwaSettings {
  id              String   @id @default("default")
  enabled         Boolean  @default(true)
  appName         String   @default("Eid Bazar")
  shortName       String   @default("Eid Bazar")
  description     String   @default("Your trusted Eid shopping destination — curated finds, fair prices, and fast delivery across Bangladesh.")
  themeColor      String   @default("#0f172a")
  backgroundColor String   @default("#ffffff")
  icon192Url      String   @default("")
  icon512Url      String   @default("")
  maskableIconUrl String   @default("")
  display         String   @default("standalone")
  orientation     String   @default("portrait")
  startUrl        String   @default("/")
  updatedAt       DateTime @updatedAt
}

model PolicyDocument {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleEn   String
  titleBn   String
  bodyEn    String   @db.Text
  bodyBn    String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Courier accounts (Steadfast, Pathao, RedX). One row, admin-managed.
model CourierSettings {
  id                    String    @id @default("default")
  /// Secret part of the webhook URLs (/api/couriers/webhook/<courier>/<key>).
  webhookKey            String    @default("")
  defaultWeightKg       Decimal   @default(0.5) @db.Decimal(5, 2)
  steadfastEnabled      Boolean   @default(false)
  steadfastApiKey       String    @default("")
  steadfastSecretKey    String    @default("")
  steadfastWebhookToken String    @default("")
  pathaoEnabled         Boolean   @default(false)
  pathaoMode            String    @default("sandbox")
  pathaoClientId        String    @default("")
  pathaoClientSecret    String    @default("")
  pathaoUsername        String    @default("")
  pathaoPassword        String    @default("")
  pathaoStoreId         Int?
  pathaoWebhookSecret   String    @default("")
  pathaoAccessToken     String    @default("")
  pathaoRefreshToken    String    @default("")
  pathaoTokenExpiresAt  DateTime?
  redxEnabled           Boolean   @default(false)
  redxMode              String    @default("sandbox")
  redxToken             String    @default("")
  redxPickupStoreId     Int?
  updatedAt             DateTime  @updatedAt
}

/// Alpha SMS (sms.net.bd) account and message templates. One row.
model SmsSettings {
  id           String   @id @default("default")
  enabled      Boolean  @default(false)
  apiKey       String   @default("")
  senderId     String   @default("")
  onPlaced     Boolean  @default(true)
  onConfirmed  Boolean  @default(false)
  onShipped    Boolean  @default(true)
  onDelivered  Boolean  @default(true)
  onCancelled  Boolean  @default(true)
  tplPlaced    String   @default("")
  tplConfirmed String   @default("")
  tplShipped   String   @default("")
  tplDelivered String   @default("")
  tplCancelled String   @default("")
  updatedAt    DateTime @updatedAt
}

/// Every SMS sent (or attempted). (orderId, event) is unique for automatic
/// messages, so each one goes out once; manual messages use a unique event.
model SmsLog {
  id        String   @id @default(cuid())
  orderId   String?
  event     String
  phone     String
  message   String   @db.Text
  status    String   @default("sending")
  error     String?
  requestId String?
  createdAt DateTime @default(now())

  @@unique([orderId, event])
  @@index([createdAt])
}

/// Rules for cash on delivery and returns. One row, admin-managed.
model OrderSettings {
  id                String   @id @default("default")
  /// Ask for a one-time SMS code before a cash-on-delivery order is placed.
  codOtpRequired    Boolean  @default(false)
  /// Largest order total allowed with cash on delivery (null = no limit).
  codMaxAmount      Int?
  returnsEnabled    Boolean  @default(true)
  /// Days after delivery a customer may ask for a return / exchange.
  returnWindowDays  Int      @default(7)
  /// Low-stock warning level for products without their own.
  lowStockDefault   Int      @default(5)
  updatedAt         DateTime @updatedAt
}

/// Phone numbers that may not order with cash on delivery (fake orders, refused parcels).
model BlockedPhone {
  id          String   @id @default(cuid())
  /// 01XXXXXXXXX
  phone       String   @unique
  reason      String   @default("")
  createdById String?
  createdAt   DateTime @default(now())
}

/// One-time codes sent by SMS (cash-on-delivery checkout). Only a hash is stored.
model OtpCode {
  id        String    @id @default(cuid())
  phone     String
  purpose   String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([phone, purpose, createdAt])
}

enum ReturnType {
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
  CANCELLED
}

/// A customer's (or admin's) request to return or exchange delivered items.
model ReturnRequest {
  id              String       @id @default(cuid())
  number          Int          @unique @default(autoincrement())
  orderId         String
  type            ReturnType
  status          ReturnStatus @default(REQUESTED)
  reason          String
  customerNote    String?
  adminNote       String?
  /// Items went back into stock when received.
  restocked       Boolean      @default(false)
  refundAmount    Decimal?     @db.Decimal(10, 2)
  refundMethod    String?
  refundReference String?
  refundedAt      DateTime?
  /// Exchange: the replacement order sent to the customer.
  replacementOrderId String?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items ReturnItem[]

  @@index([orderId])
  @@index([status, createdAt])
}

model ReturnItem {
  id          String  @id @default(cuid())
  returnId    String
  orderItemId String
  quantity    Int
  /// Exchange: the option the customer wants instead (same product).
  exchangeVariantId String?
  exchangeLabel     String?

  request   ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([returnId])
}

/// Every change to stock, with why (sale, cancel, return, edit, adjust, import…).
model StockMovement {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  change    Int
  reason    String
  orderId   String?
  note      String?
  userId    String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([createdAt])
}

/// Who did what in the admin panel. Append-only.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userLabel  String   @default("")
  action     String
  targetType String?
  targetId   String?
  summary    String   @default("")
  data       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([userId, createdAt])
}

/// A one-time password reset link. Only the SHA-256 of the token is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Admin-panel security rules. One row.
model AdminSettings {
  id             String   @id @default("default")
  /// Owner and staff must turn on two-factor sign-in before using the admin panel.
  require2fa     Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

/// A signed-in shopper's cart as last seen (the cart itself lives in the
/// browser). Used to find abandoned carts and send a reminder.
model CartSnapshot {
  id            String    @id @default(cuid())
  userId        String    @unique
  /// [{ productId, variantId, quantity }] — names and prices are read fresh.
  items         Json      @default("[]")
  itemCount     Int       @default(0)
  /// Shop price of the items when last synced (for sorting / display).
  value         Decimal   @default(0) @db.Decimal(10, 2)
  updatedAt     DateTime  @default(now())
  remindedAt    DateTime?
  reminderCount Int       @default(0)
  reminderCoupon String?
  /// An order placed after a reminder.
  recoveredOrderId String?
  recoveredAt   DateTime?

  @@index([updatedAt])
  @@index([remindedAt])
}

/// A promotional SMS to a group of customers.
model SmsCampaign {
  id          String    @id @default(cuid())
  name        String
  message     String    @db.Text
  /// The customer filter used (segment, days, district, category…).
  audience    Json
  status      String    @default("sending") // sending | done | failed
  recipients  Int       @default(0)
  sent        Int       @default(0)
  failed      Int       @default(0)
  smsParts    Int       @default(1)
  error       String?
  createdById String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([createdAt])
}

/// Facebook Conversions API and the product feed. One row. (The Pixel,
/// GA4 and GTM IDs live in the SEO settings.)
model TrackingSettings {
  id             String   @id @default("default")
  /// Conversions API access token (server-side Purchase events).
  fbCapiToken    String   @default("")
  /// Set while testing in Events Manager → Test events; empty in normal use.
  fbTestCode     String   @default("")
  /// Product feed at /feeds/products.xml (Facebook / Google catalogue).
  feedEnabled    Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

/// Abandoned-cart reminders. One row.
model CartReminderSettings {
  id          String   @id @default("default")
  /// Send reminders by themselves once a day (late morning, Dhaka time).
  auto        Boolean  @default(false)
  /// A cart counts as abandoned after this many hours without an order.
  afterHours  Int      @default(3)
  /// Optional coupon code put in the message.
  couponCode  String   @default("")
  /// Message template; empty = the default text.
  template    String   @default("")
  updatedAt   DateTime @updatedAt
}

/// A message sent from the Contact page.
model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  phone     String    @default("")
  email     String    @default("")
  orderRef  String    @default("")
  message   String    @db.Text
  userId    String?
  ip        String?
  handledAt DateTime?
  handledBy String?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([handledAt])
}
